{
  "name": "lane_shooter",
  "private": true,
  "type": "module",
  "description": "Rehlaty squad shooter + archers bridge (three.js, shared sim). Built into assets/games/squad_shooter and archer_bridge",
  "scripts": {
    "build": "esbuild src/squad.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/squad_shooter/game.js && esbuild src/archers.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/archer_bridge/game.js",
    "test": "node --test test/sim.test.js"
  },
  "dependencies": { "three": "0.170.0" },
  "devDependencies": { "esbuild": "0.24.0" }
}
