{
  "name": "learn_games",
  "private": true,
  "type": "module",
  "description": "Rehlaty rebuilt learning games (docs/LEARNING_GAMES_REBUILD.md). One folder per game in src/, a shared kit in src/kit. Each is built into assets/games/learn_<id>/game.js",
  "scripts": {
    "build:maze": "esbuild src/maze/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_maze/game.js",
    "build": "npm run build:maze && npm run build:sort && npm run build:treasure && npm run build:day && npm run build:ladders && npm run build:ball && npm run build:pattern && npm run build:letters && npm run build:counting && npm run build:shapes && npm run build:animals",
    "test": "node --test",
    "build:sort": "esbuild src/sort/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_sort/game.js",
    "build:treasure": "esbuild src/treasure/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_treasure/game.js",
    "build:day": "esbuild src/day/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_day/game.js",
    "build:ladders": "esbuild src/ladders/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_ladders/game.js",
    "build:ball": "esbuild src/ball/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_ball/game.js",
    "build:pattern": "esbuild src/pattern/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_pattern/game.js",
    "build:letters": "esbuild src/letters/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_letters/game.js",
    "build:counting": "esbuild src/counting/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_counting/game.js",
    "build:shapes": "esbuild src/shapes/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_shapes/game.js",
    "build:animals": "esbuild src/animals/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../assets/games/learn_animals/game.js"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}