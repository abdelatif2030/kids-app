# Cloudflare Pages headers for the DEMO LOGIN build only (tool/build_demo_login.sh copies this over web/_headers in the
# build output; the repository's web/_headers stays the strict, talks-to-nobody file).
# Allowed on top of the strict file, only so Firebase Auth (Google popup + e-mail/password) and Firestore can work:
#   scripts   : Google API loader (apis.google.com, www.gstatic.com), Google sign-in button script (accounts.google.com) and
#               the inline loader scripts of firebase_core_web (core, auth, firestore; Chrome and Safari variants), each allowed by exact hash
#               (hashes are for Firebase JS SDK 13.1.0 / firebase_core_web 4.1.0; recompute with tool/csp_hashes.py after a plugin upgrade)
#   connect   : Identity Toolkit, Secure Token, Firestore, Firebase Installations
#   frames    : the project's auth handler (kids-app-2361e.firebaseapp.com) and accounts.google.com (sign-in popup/iframe)
# No analytics host is allowed. The Cross-Origin-Opener-Policy header is deliberately NOT set (it would break the popup).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-YYaa/Ai2XuluQa6sbDZmBFePjXaJErauT33uzHZRB1Y=' 'sha256-YE4XeMtzbmXoK0iniV4w5yeEvANP61G11Z0qhaAcoHU=' 'sha256-lxY7MwgY05//x5PJru5QZIF5G3LSEYRi/NpG8F32UmE=' 'sha256-E5pQKGuCE4yyzi3hBHqfnUZ9xuaXZ4NGzdrGhm0zDsk=' 'sha256-N3kpEfDnGZMIvG+dJIvE5lI1NKt7qqDGQieQvkwB0/g=' 'sha256-ZWdHmF/GV+qIgh+aG+BIfWaNlYa1tnUISMgZ5MRRmf8=' https://apis.google.com https://www.gstatic.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' https://pub-9f36e80d6d2349feb9be77f9ef1dc3ad.r2.dev data: blob: https://lh3.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://pub-9f36e80d6d2349feb9be77f9ef1dc3ad.r2.dev data: blob: https://fonts.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaseinstallations.googleapis.com https://www.googleapis.com https://accounts.google.com; media-src 'self' https://pub-9f36e80d6d2349feb9be77f9ef1dc3ad.r2.dev blob: data:; worker-src 'self' blob:; frame-src https://kids-app-2361e.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

