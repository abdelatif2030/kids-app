 },
 {
  "id": "0550f6ef",
  "text": "كورة"
 },
 {
  "id": "cfd90d22",
  "text": "كورة حمرا"
 },
 {
  "id": "a1582f50",
  "text": "لسه بدري عليها!"
 },
 {
  "id": "7b71ef28",
  "text": "لقيت الكنز! شاطر"
 },
 {
  "id": "8fbe8762",
  "text": "لقيتي الكنز! شاطرة"
 },
 {
  "id": "fd7ee1e3",
  "text": "مركب"
 },
 {
  "id": "97306602",
  "text": "مش دي... بُص على الترتيب تاني"
 },
 {
  "id": "c066f314",
  "text": "مش دي... جرّب سلة تانية"
 },
 {
  "id": "9f878b82",
  "text": "مش هنا... اسمع الببغاء تاني"
 },
 {
  "id": "10970b6c",
  "text": "مش هنا... اسمع تاني"
 },
 {
