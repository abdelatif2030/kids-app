 },
 {
  "id": "f751dba0",
  "text": "حط كل حاجة في السلة بتاعتها!"
 },
 {
  "id": "3f19d6eb",
  "text": "حلقة بنفسجي"
 },
 {
  "id": "23257be9",
  "text": "خلصتها تاني! برافو عليك"
 },
 {
  "id": "e773acee",
