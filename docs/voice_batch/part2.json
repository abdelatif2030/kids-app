  "id": "748ff59b",
  "text": "ستة وعشرين"
 },
 {
  "id": "1e4c2e72",
  "text": "سلّم! اطلع لفوق"
 },
 {
  "id": "81d2f882",
  "text": "سمكة"
 },
 {
  "id": "3c69fff1",
  "text": "شاطر أوي! خدت نجمة جديدة!"
 },
 {
  "id": "f7724c47",
  "text": "شاطرة أوي! خدتي نجمة جديدة!"
 },
