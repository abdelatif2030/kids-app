 },
 {
  "id": "02451203",
  "text": "دبدوب"
 },
 {
  "id": "746c98ad",
  "text": "ده مكان مش للحفر"
 },
 {
  "id": "366e0bfa",
  "text": "دور الدبدوب"
 },
 {
  "id": "d8fc5b8c",
  "text": "دورك! دوس على الزهر"
 },
 {
  "id": "72dcc26f",
  "text": "دورك! دوسي على الزهر"
 },
 {
  "id": "b5d4b835",
  "text": "دوس على المكان اللي فيه الكنز"
 },
 {
  "id": "4aa17dab",
  "text": "رتّب في مجموعات"
 },
 {
  "id": "fb421e1e",
  "text": "رتّب يومك! إيه اللي بيحصل الأول؟"
 },
 {
  "id": "d6887b4c",
  "text": "رتّب يومي"
 },
 {
  "id": "6edaed46",
  "text": "زحليقة! وييي"
 },
 {
