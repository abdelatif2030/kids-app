 },
 {
  "id": "f0dcdd3d",
  "text": "واحد، اتنين، تلاتة، أربعة، خمسة، ستة"
 },
 {
  "id": "f79700a8",
  "text": "وبعدين؟"
 },
 {
  "id": "277e09c5",
  "text": "وصلت للعلم الأول!"
 },
 {
  "id": "ce30a158",
  "text": "وصلتي للعلم الأول!"
 },
 {
  "id": "f335e13e",
  "text": "يوم جميل! رتّبته صح"
 },
 {
  "id": "d85372af",
  "text": "يوم جميل! رتّبتيه صح"
 },
 {
