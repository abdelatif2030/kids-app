rules_version = '2';

// Paste into Firebase console > Firestore > Rules (see docs/teachers-setup.md).
// Teachers are visible to parents as soon as they save their profile. To hide a
// teacher, open teachers/{uid} in the console and set status to "suspended"
// (a teacher can never lift that). Parents' reports are in the "reports"
// collection, readable only in the console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // users/{uid}: role and display name, readable only by the owner.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'createdAt'])
        && request.resource.data.role in ['parent', 'teacher'];
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // teachers/{uid}: parents see profiles whose status is "approved". A teacher
    // sees and edits their own, but can never lift a suspension.
    match /teachers/{uid} {
      allow read: if signedIn()
        && (resource.data.status == 'approved' || request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && role() == 'teacher'
        && request.resource.data.status == 'approved'
        && request.resource.data.get('photoB64', '').size() < 150000;
      allow update: if signedIn() && request.auth.uid == uid
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending' && request.resource.data.status == 'approved'))
        && request.resource.data.get('photoB64', '').size() < 150000;
      allow delete: if false;
    }

    // teacherFiles/{uid}: the CV (small, base64). The teacher writes their own;
    // signed-in users can read the CV of an approved teacher.
    match /teacherFiles/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || get(/databases/$(database)/documents/teachers/$(uid)).data.status == 'approved');
      allow create, update: if signedIn() && request.auth.uid == uid
        && role() == 'teacher'
        && request.resource.data.keys().hasOnly(['cvName', 'cvB64'])
        && request.resource.data.cvName.size() < 120
        && request.resource.data.cvB64.size() < 700000;
      allow delete: if false;
    }

    // reports/{id}: a parent reports a teacher. Nobody can read them in the app;
    // you read them in the Firebase console.
    match /reports/{id} {
      allow create: if signedIn() && role() == 'parent'
        && request.resource.data.keys().hasOnly(['teacherUid', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason.size() < 500;
      allow read, update, delete: if false;
    }

    // bookings/{id}: lesson requests. Only the parent and the teacher involved
    // can read one. No child data except an optional age.
    match /bookings/{id} {
      allow read: if signedIn()
        && (resource.data.parentUid == request.auth.uid
            || resource.data.teacherUid == request.auth.uid);
      allow create: if signedIn() && role() == 'parent'
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.lessonLink == null
        && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherUid)).data.status == 'approved';
      // The teacher accepts (with an https lesson link) or declines.
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lessonLink'])
        && request.resource.data.status in ['accepted', 'declined']
        && (request.resource.data.status == 'declined'
            || request.resource.data.lessonLink.matches('https://.+'));
      // The parent can only cancel.
      allow update: if signedIn() && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }
  }
}
