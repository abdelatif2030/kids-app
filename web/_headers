# Cloudflare Pages reads this file from the build output (copied from web/ by `flutter build web`).
# The demo is a static, offline-first page: it should talk to nobody except its own origin.
# Fonts for emoji and rare glyphs are fetched by Flutter from fonts.gstatic.com (no child data in those requests).
# The Google Identity script that a plugin tries to load at start-up is blocked on purpose (no sign-in in the demo).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://fonts.gstatic.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/flutter_service_worker.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
