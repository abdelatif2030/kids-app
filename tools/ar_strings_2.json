[
"لون",
"كم عدد الأشياء؟",
"عُدّ واحداً واحداً بإصبعك.",
"ما ناتج الجمع؟",
"ما ناتج الطرح؟",
"ما ناتج الضرب؟",
"ما اسم هذا الشكل؟",
"انظر إلى الأضلاع والزوايا.",
"ما لون هذا الشكل؟",
"تذكّر ألوان قوس المطر.",
"ما اسم هذه الصورة بالإنجليزية؟",
"اقرأ القصة مرة أخرى وابحث عن الإجابة.",
"اقرأ السؤال بتمهّل ثم اختر الإجابة.",
"العدّ يزيد واحداً كل مرة."
]