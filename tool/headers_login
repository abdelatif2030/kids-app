# Cloudflare Pages headers for the DEMO LOGIN build only (tool/build_demo_login.sh copies this over web/_headers in the
# build output; the repository's web/_headers stays the strict, talks-to-nobody file).
# Allowed on top of the strict file, only so Firebase Auth (Google popup + e-mail/password) and Firestore can work:
#   scripts   : Google API loader (apis.google.com, www.gstatic.com), Google sign-in button script (accounts.google.com) and
#               ONE inline script allowed by its exact hash (firebase_core_web's loader of the Firebase JS SDK)
#   connect   : Identity Toolkit, Secure Token, Firestore, Firebase Installations
#   frames    : the project's auth handler (kids-app-2361e.firebaseapp.com) and accounts.google.com (sign-in popup/iframe)
# No analytics host is allowed. The Cross-Origin-Opener-Policy header is deliberately NOT set (it would break the popup).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-YYaa/Ai2XuluQa6sbDZmBFePjXaJErauT33uzHZRB1Y=' https://apis.google.com https://www.gstatic.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: https://img.youtube.com https://i3.ytimg.com https://lh3.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://fonts.gstatic.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaseinstallations.googleapis.com https://www.googleapis.com https://accounts.google.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://kids-app-2361e.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/flutter_service_worker.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
